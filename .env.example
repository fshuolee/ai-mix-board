# ==========================================
# AI Mix Board 環境變數設定
# ==========================================

# 1. Gemini API Key (必要)
# 前往 https://aistudio.google.com/app/apikey 取得
GEMINI_API_KEY=

# 2. Google OAuth 2.0 Web Client ID (選填)
# 用於 Google Drive & Google Sheets 登入連線
# 可在 GCP Console (專案: prototyper / deemo-reborn-90033034) 的「憑證」中建立 OAuth 2.0 Client ID (Web 應用程式)
# 授權的 JavaScript 來源請填寫: http://localhost:3000
VITE_GOOGLE_CLIENT_ID=
